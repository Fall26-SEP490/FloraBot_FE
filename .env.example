SITE_URL=https://your-domain.example
PUBLIC_API_URL=/api
# Server-only proxy target. Local default is below; Vercel defaults to https://api.florabot.site.
# Set https://api.florabot.site here when testing local FE with the deployed API.
API_PROXY_TARGET=http://127.0.0.1:5080
# Separate kiosk app built with VITE_BASE_PATH=/kiosk/.
KIOSK_PROXY_TARGET=http://127.0.0.1:5174
# Optional kiosk handoff URL; production defaults to the same origin /receipt.
VITE_RECEIPT_URL=

# Goong Maps Keys (https://account.goong.io/)
# Maptiles key used for rendering map tiles (falls back to OpenStreetMap/Leaflet if empty)
NEXT_PUBLIC_GOONG_MAPTILES_KEY=
# REST API key used for Goong Places Autocomplete, Place Detail, Geocoding, Directions
NEXT_PUBLIC_GOONG_API_KEY=
