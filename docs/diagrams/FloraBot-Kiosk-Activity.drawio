g nhập SĐT để nhận preorder." style="text;html=1;align=left;fontSize=12;fontColor=#476451;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1200" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="Khách hàng" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="2430" as="geometry"/></mxCell><mxCell id="lane1" value="Giao diện kiosk" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="300" height="2430" as="geometry"/></mxCell><mxCell id="lane2" value="Backend" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="300" height="2430" as="geometry"/></mxCell><mxCell id="lane3" value="Thiết bị / IoT" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="300" height="2430" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#183e2b;strokeColor=#183e2b;" vertex="1" parent="lane0"><mxGeometry x="138" y="65" width="24" height="24" as="geometry"/></mxCell><mxCell id="entry" value="Đến đúng kiosk&lt;br&gt;Chọn “Nhận đơn đặt trước”" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;spacing=8;strokeColor=#52735a;fillColor=#f7fbf5;fontColor=#183e2b;" vertex="1" parent="lane0"><mxGeometry x="26" y="115" width="248" height="66" as="geometry"/></mxCell><mxCell id="input" value="Nhập mã 8 chữ số&lt;br&gt;trong email nhận hoa" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;spacing=8;strokeColor=#52735a;fillColor=#f7fbf5;fontColor=#183e2b;" vertex="1" parent="lane0"><mxGeometry x="26" y="235" width="248" height="66" as="geometry"/></mxCell><mxCell id="format" value="Đủ 8 chữ số?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;spacing=5;strokeColor=#a38135;fillColor=#fff8e6;fontColor=#59420d;" vertex="1" parent="lane1"><mxGeometry x="62" y="345" width="176" height="88" as="geometry"/></mxCell><mxCell id="formatError" value="Báo lỗi định dạng&lt;br&gt;Cho phép nhập lại" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;spacing=8;strokeColor=#52735a;fillColor=#f7fbf5;fontColor=#183e2b;" vertex="1" parent="lane1"><mxGeometry x="26" y="470" width="248" height="66" as="geometry"/></mxCell><mxCell id="review" value="Kiểm tra đúng kiosk, cửa đã đóng&lt;br&gt;Xác nhận mở ô nhận hoa" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;spacing=8;strokeColor=#52735a;fillColor=#f7fbf5;fontColor=#183e2b;" vertex="1" parent="lane0"><mxGeometry x="26" y="580" width="248" height="66" as="geometry"/></mxCell><mxCell id="send" value="Tạo attemptId cho lượt nhận&lt;br&gt;Gửi mã + attemptId tới backend" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;spacing=8;strokeColor=#52735a;fillColor=#f7fbf5;fontColor=#183e2b;" vertex="1" parent="lane1"><mxGeometry x="26" y="700" width="248" height="66" as="geometry"/></mxCell><mxCell id="validate" value="Kiểm tra mã, hạn, đúng kiosk, đơn đã trả tiền, hoa đã nạp và điều kiện mở ô" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;spacing=8;strokeColor=#52735a;fillColor=#f7fbf5;fontColor=#183e2b;" vertex="1" parent="lane2"><mxGeometry x="26" y=