<mxfile host="app.diagrams.net" modified="2026-11-01T00:00:00.000Z" agent="FloraBot" version="24.7.17" type="device"><diagram id="overview" name="01 · Tổng quan luồng kiosk"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="01 · Tổng quan luồng kiosk" style="text;html=1;align=left;fontSize=24;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Mua trực tiếp và nhận đơn đặt trước dùng chung bước giao hoa. Nhánh chi tiết và phục hồi được tách sang trang 02–04." style="text;html=1;align=left;fontSize=12;fontColor=#476451;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1200" height="35" as="geometry"/></mxCell><mxCell id="lane0" value="Khách hàng" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="1670" as="geometry"/></mxCell><mxCell id="lane1" value="Giao diện kiosk" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="300" height="1670" as="geometry"/></mxCell><mxCell id="lane2" value="Backend / nghiệp vụ" style="swimlane;html=1;horizontal=1;startSize=42;collapsible=0;rounded=0;fillColor=#eaf5e6;swimlaneFillColor=#ffffff;strokeColor=#9db3a0;fontSize=15;fontStyle=1;fontColor=#183e2b;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="300" height="1670" as="geometry"/></mxCell><mxCell id="lane3" value="Thiết bị / IoT" style="swimlane;html=1;horiz