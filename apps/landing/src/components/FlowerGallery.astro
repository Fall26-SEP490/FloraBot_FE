---
import { flowerPhotos } from '@florabot/ui/flower-photos';
import FlowerPhoto from './FlowerPhoto.astro';
const collection = [
  flowerPhotos.sunflowers,
  flowerPhotos.pinkTulip,
  flowerPhotos.whiteRose,
  flowerPhotos.cherryBlossom,
  flowerPhotos.callaLilies,
  flowerPhotos.stripedTulips,
  flowerPhotos.roseGarden,
  flowerPhotos.pinkLilies,
];
---

<div class="floral-collection" aria-label="Bộ sưu tập cảm hứng hoa">
  {
    collection.map((photo) => (
      <figure>
        <FlowerPhoto photo={photo} sizes="(max-width: 700px) 90vw, 60vw" />
      </figure>
    ))
  }
</div>
<style>
  .floral-collection {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  figure:first-child {
    grid-column: span 2;
  }
  .floral-collection :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
  }
  figure:first-child :global(img) {
    aspect-ratio: 8 / 3;
  }
  @media (max-width: 700px) {
    .floral-collection {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }
    figure:last-child {
      grid-column: span 2;
    }
    figure:first-child :global(img),
    figure:last-child :global(img) {
      aspect-ratio: 16 / 9;
    }
  }
</style>
