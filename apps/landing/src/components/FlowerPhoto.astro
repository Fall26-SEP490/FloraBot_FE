---
import type { FlowerPhoto } from '@florabot/ui/flower-photos';
interface Props {
  photo: FlowerPhoto;
  sizes?: string;
  alt?: string;
  class?: string;
}
const {
  photo,
  sizes = '(max-width: 700px) 44vw, 22vw',
  alt = photo.alt,
  class: className,
} = Astro.props;
---

<picture>
  <source type="image/avif" srcset={photo.avifSrcSet} sizes={sizes} />
  <img
    src={photo.src}
    srcset={photo.webpSrcSet}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={alt}
    class={className}
    loading="lazy"
    decoding="async"
  />
</picture>
