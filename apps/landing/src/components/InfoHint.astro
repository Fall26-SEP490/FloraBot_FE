---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<details class="info-hint">
  <summary>
    <svg
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <circle cx="12" cy="12" r="9"></circle><path d="M12 11v6"></path><circle
        cx="12"
        cy="7.5"
        r=".8"
        fill="currentColor"
        stroke="none"></circle>
    </svg>
    <span>{label}</span>
  </summary>
  <div class="info-content"><slot /></div>
</details>
