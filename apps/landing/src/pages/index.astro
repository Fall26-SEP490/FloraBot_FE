---
import Layout from '../layouts/Layout.astro';
import Registration from '../components/Registration';
import KioskMap from '../components/KioskMap';
import GiftDemo from '../components/GiftDemo';
import FlowerPhoto from '../components/FlowerPhoto.astro';
import FlowerGallery from '../components/FlowerGallery.astro';
import { flowerPhotos } from '@florabot/ui/flower-photos';
import { packages } from '@florabot/contracts';
const portal = (import.meta.env.PUBLIC_PORTAL_URL || 'http://localhost:8088')
  .replace(/\/login$/, '')
  .replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'FloraBot',
      url: Astro.site?.toString(),
      description: 'Dự án kiosk bán hoa theo gói thuê cho shop hoa.',
    },
    ...packages.map((plan) => ({
      '@type': 'Product',
      name: `Gói FloraBot ${plan.name}`,
      description: `Thuê tối đa ${plan.slots} ô kiosk theo tháng.`,
      offers: { '@type': 'Offer', price: String(plan.fee), priceCurrency: 'VND' },
    })),
  ],
};
---

<Layout>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/generated/florabot-hero.webp"
    fetchpriority="high"
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span>Một bó hoa, </span><span class="hero-highlight">thật nhiều thương.</span>
        </h1>
        <p>
          Chọn mẫu bạn thích, để shop chăm chút và gửi đến tủ theo lịch hẹn. Hoặc chọn ngay một bó
          hoa có sẵn gần bạn.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${portal}/dat-hoa`}
            >Chọn hoa & đặt trước <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
            ></a
          >
          <p class="hero-rate"><a href="#goi-thue">Bạn là shop hoa? Khám phá gói thuê tủ</a></p>
        </div>
      </div>
      <div class="hero-garden">
        <figure class="hero-cabinet">
          <img
            class="garden-photo"
            src="/images/generated/florabot-hero.webp"
            width="1200"
            height="800"
            fetchpriority="high"
            alt="Minh họa tủ bán hoa xanh với tám ngăn hoa, bao quanh bởi tulip và hoa cúc"
          />
        </figure>
      </div>
    </section>

    <section id="dat-truoc" class="section preorder-story" aria-labelledby="preorder-title">
      <div class="preorder-intro">
        <h2 id="preorder-title">Bạn chọn lời thương.<br />Shop chăm chút bó hoa.</h2><p>
          Chọn mẫu bạn thích, kể shop nghe mong muốn và hẹn nhận tại tủ thuận tiện cho bạn.
        </p><div class="preorder-actions">
          <a class="button button-primary" href={`${portal}/dat-hoa`}
            >Chọn một bó hoa <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
            ></a
          ><a class="text-link" href="/huong-dan-dat-hoa">Xem hướng dẫn đặt hoa</a>
        </div><div class="preorder-ready">
          <FlowerPhoto photo={flowerPhotos.pastelBouquet} sizes="96px" /><p>
            <strong>Cần hoa sớm hơn?</strong><br />Chọn bó có sẵn tại tủ và xem hạn nhận trước khi
            thanh toán.
          </p>
        </div>
      </div>
      <ol class="preorder-steps">
        <li>
          <span aria-hidden="true">01</span><div>
            <h3>Chọn hoa, gửi mong muốn</h3><p>
              Chọn mẫu, tủ nhận và thời gian mong muốn. Ghi thêm màu hoa, ngân sách hoặc lời nhắn
              của bạn.
            </p>
          </div>
        </li><li>
          <span aria-hidden="true">02</span><div>
            <h3>Ưng ý rồi mới thanh toán</h3><p>
              Shop gửi báo giá và lịch nhận. Bạn kiểm tra, xác nhận rồi thanh toán để shop chuẩn bị.
            </p>
          </div>
        </li><li>
          <span aria-hidden="true">03</span><div>
            <h3>Hoa sẵn sàng, bạn ghé nhận</h3><p>
              Theo dõi đơn trong tài khoản. Đến đúng tủ theo lịch hẹn và dùng mã trên biên nhận để
              lấy hoa.
            </p>
          </div>
        </li>
      </ol>
    </section><div class="graphic-divider" aria-hidden="true"></div>

    <section id="cach-hoat-dong" class="section how" aria-labelledby="how-title">
      <h2 id="how-title">Bán hoa tại tủ như thế nào?</h2>
      <ol class="steps">
        <li>
          <img
            class="step-art"
            src="/images/generated/florabot-step-stock.webp"
            width="600"
            height="600"
            loading="lazy"
            alt=""
          /><div class="step-copy">
            <span class="step-number" aria-hidden="true">01</span><div>
              <h3>Shop đưa hoa vào tủ</h3><p>Chọn ô thuê, đặt giá và hạn bán.</p>
            </div>
          </div>
        </li>
        <li>
          <img
            class="step-art"
            src="/images/generated/florabot-step-buy.webp"
            width="600"
            height="600"
            loading="lazy"
            alt=""
          /><div class="step-copy">
            <span class="step-number" aria-hidden="true">02</span><div>
              <h3>Khách mua tại tủ</h3><p>Chọn hoa, quét VietQR và nhận hoa.</p>
            </div>
          </div>
        </li>
        <li>
          <img
            class="step-art"
            src="/images/generated/florabot-step-manage.webp"
            width="600"
            height="600"
            loading="lazy"
            alt=""
          /><div class="step-copy">
            <span class="step-number" aria-hidden="true">03</span><div>
              <h3>Shop theo dõi bán hàng</h3><p>Xem đơn hàng và số dư trên cổng quản lý.</p>
            </div>
          </div>
        </li>
      </ol>

      <a class="section-next" href="#goi-thue"
        >So sánh gói thuê <span aria-hidden="true"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </section>

    <section id="goi-thue" class="pricing-section section" aria-labelledby="pricing-title">
      <div class="section-intro">
        <h2 id="pricing-title">Gói thuê ô tủ</h2><p>Phí cố định mỗi tháng. Không thu hoa hồng.</p>
      </div>
      <div class="price-options">
        {
          packages.map((plan, index) => (
            <article
              class:list={['plan', { 'plan-featured': index === 1 }]}
              aria-labelledby={`package-${plan.id}`}
            >
              <div class="plan-top">
                <>
                  <h3 id={`package-${plan.id}`}>{plan.name}</h3>
                  <span class="plan-capacity">Tối đa {plan.slots} ô</span>
                </>
              </div>
              <p class="plan-price">
                <>
                  <strong>{plan.fee.toLocaleString('vi-VN')}</strong>
                  <span>đ / tháng</span>
                </>
              </p>
              <a class="button choose-package" data-package={plan.id} href="#dang-ky">
                Chọn {plan.name}
                <svg
                  aria-hidden="true"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>

      <a class="section-next" href="#vi-tri"
        >Xem vị trí tủ <span aria-hidden="true"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </section>

    <section id="vi-tri" class="section locations" aria-labelledby="locations-title">
      <div class="section-intro">
        <h2 id="locations-title">Vị trí tủ bán hoa</h2><span class="context-label"
          >Địa điểm minh họa · TP.HCM</span>
      </div>
      <div class="location-layout">
        <div>
          <ul class="location-list">
            <li><h3>Nhà Văn hóa Thanh Niên</h3><p>4 Phạm Ngọc Thạch, Quận 1, TP.HCM</p></li><li>
              <h3>Đại học FPT</h3><p>Lô E2a-7, Khu Công nghệ cao, Thủ Đức, TP.HCM</p>
            </li>
          </ul>
          <a class="text-link" href="#dang-ky"
            >Tư vấn vị trí thuê <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg
            ></a
          >
        </div>
        <KioskMap client:visible />
        <noscript><p>Bật JavaScript để mở bản đồ tương tác.</p></noscript>
      </div>
      <a class="section-next" href="#bo-suu-tap"
        >Khám phá hoa <span aria-hidden="true"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </section>

    <section id="bo-suu-tap" class="section gift-section" aria-labelledby="gift-title">
      <h2 id="gift-title">Bộ sưu tập hoa</h2>
      <FlowerGallery />
      <div class="flower-ribbon">
        <FlowerPhoto photo={flowerPhotos.tulipVase} sizes="(max-width: 700px) 90vw, 30vw" />
        <FlowerPhoto photo={flowerPhotos.redRoses} sizes="(max-width: 700px) 90vw, 30vw" />
        <FlowerPhoto photo={flowerPhotos.pastelBouquet} sizes="(max-width: 700px) 90vw, 30vw" />
      </div>
      <div class="gift-tool">
        <GiftDemo client:visible /><noscript
          ><p>Bật JavaScript để chọn hoa theo ngân sách.</p></noscript>
      </div>

      <a class="section-next" href="#quan-ly"
        >Xem cách quản lý <span aria-hidden="true"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </section>

    <section id="quan-ly" class="section money-section" aria-labelledby="money-title">
      <img
        class="money-photo"
        src="/images/floral-white-online.webp"
        width="900"
        height="1440"
        loading="lazy"
        decoding="async"
        alt="Hoa hồng nhiều màu và hoa tím trên nền lá xanh"
      />
      <div class="money-copy">
        <h2 id="money-title">Quản lý đơn hàng và tiền bán</h2><div class="money-benefits">
          <article><h3>Theo dõi từng đơn hàng</h3></article>
          <article><h3>Xem số dư và rút tiền</h3></article>
          <article><h3>Xử lý đơn gặp sự cố</h3></article>
        </div>
      </div>
      <a class="section-next" href="#cau-hoi"
        >Câu hỏi thường gặp <span aria-hidden="true"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </section>

    <section id="cau-hoi" class="section faq-section" aria-labelledby="faq-title">
      <div class="faq-visual">
        <h2 id="faq-title">Câu hỏi thường gặp</h2><img
          src="/images/floral-pink-online.webp"
          width="900"
          height="1125"
          loading="lazy"
          decoding="async"
          alt="Một cành hoa diên vĩ hồng trên nền sáng"
        />
      </div>
      <div class="faq-list">
        <details>
          <summary>Đăng ký tư vấn có mất phí không?</summary><p>
            Không. Bạn chỉ thanh toán gói thuê sau khi vị trí và hồ sơ shop được xác nhận.
          </p>
        </details>
        <details>
          <summary>Shop cần chuẩn bị những gì?</summary><p>
            Shop chuẩn bị hoa, đặt giá, hạn bán và bố trí người bổ sung hoa, kiểm tra chất lượng,
            lấy hoa hết hạn về.
          </p>
        </details>
        <details>
          <summary>Khách mua hoa tại tủ như thế nào?</summary><p>
            Khách chọn hoa, quét VietQR để thanh toán và nhận hoa tại ô tủ.
          </p>
        </details>
        <details>
          <summary>Khách trả tiền nhưng không nhận được hoa?</summary><p>
            Khách dùng mã biên nhận để báo sự cố và theo dõi xử lý. Khi xác nhận không giao được
            hoa, đội ngũ hoàn tiền có chứng từ.
          </p>
        </details>
        <details>
          <summary>Hoa hết hạn bán được xử lý ra sao?</summary><p>
            Hệ thống ẩn hoa hết hạn khỏi danh mục và cảnh báo trên cổng quản lý. Shop kiểm tra chất
            lượng và lấy hoa về.
          </p>
        </details>
      </div>
      <a class="section-next" href="#dang-ky"
        >Đăng ký tư vấn <span aria-hidden="true"
          ><svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 5v14m-6-6 6 6 6-6"></path></svg
          ></span
        ></a
      >
    </section>

    <section
      id="dang-ky"
      class="section registration-section"
      aria-labelledby="registration-title"
      tabindex="-1"
    >
      <div class="registration-copy">
        <h2 id="registration-title">Tư vấn thuê ô tủ</h2><span class="context-label"
          >Miễn phí tư vấn</span
        ><FlowerPhoto
          photo={flowerPhotos.flowerShop}
          class="registration-flowers"
          sizes="(max-width: 700px) 90vw, 40vw"
        />
      </div>
      <div>
        <Registration client:visible /><noscript
          ><p>Bật JavaScript để gửi đăng ký trực tuyến.</p></noscript>
      </div>
    </section>
  </main>
  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const entranceAnimations = new Set<Animation>();
    const sections = [...document.querySelectorAll('.section')];
    const animateEntrance = (element: Element, delay = 0, direction?: number) => {
      if (reducedMotion.matches) return;
      const graphic = element.matches('img');
      const sectionIndex = sections.indexOf(element.closest('.section')!);
      const step = element.closest('li');
      const stepIndex = step ? [...step.parentElement!.children].indexOf(step) : -1;
      const from = direction ?? ((stepIndex >= 0 ? stepIndex : sectionIndex) % 2 === 0 ? -1 : 1);
      const distance = Math.min(window.innerWidth * 0.09, graphic ? 48 : 72);
      const animation = element.animate(
        [
          graphic
            ? { opacity: 0.45, transform: `translateX(${from * distance}px) scale(.98)` }
            : { opacity: 0.15, transform: `translateX(${from * distance}px)` },
          { opacity: 1, transform: 'none' },
        ],
        { duration: graphic ? 1100 : 1000, delay, easing: 'cubic-bezier(.22,1,.36,1)' },
      );
      entranceAnimations.add(animation);
      void animation.finished.then(
        () => entranceAnimations.delete(animation),
        () => entranceAnimations.delete(animation),
      );
    };
    document
      .querySelectorAll('.hero h1 > span, .hero-copy > p, .hero-actions')
      .forEach((element, index) => animateEntrance(element, index * 100, index === 1 ? 1 : -1));
    const entranceObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateEntrance(entry.target);
            entranceObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    document
      .querySelectorAll(
        '.section h2, .step-copy, .money-photo, .faq-visual img, .registration-flowers, .gift-picker-art img',
      )
      .forEach((element) => entranceObserver.observe(element));
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) entranceAnimations.forEach((animation) => animation.cancel());
    });
    const motionTargets = document.querySelectorAll(
      '.steps, .gift-demo, .graphic-divider, .section-next',
    );
    const motionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in-view');
            motionObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    motionTargets.forEach((target) => motionObserver.observe(target));
    document.querySelectorAll<HTMLAnchorElement>('.choose-package').forEach((link) =>
      link.addEventListener('click', () => {
        document.documentElement.dataset.selectedPackage = link.dataset.package;
        window.dispatchEvent(new CustomEvent('florabot:package', { detail: link.dataset.package }));
        document.querySelector<HTMLElement>('#dang-ky')?.focus({ preventScroll: true });
      }),
    );
  </script>
</Layout>
